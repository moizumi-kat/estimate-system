# /etc/terminal-system.env の雛形。実ファイルは chmod 600 で root 所有にし、Git には含めない。
#   sudo cp deploy/terminal-system.env.example /etc/terminal-system.env
#   sudo chmod 600 /etc/terminal-system.env
# ※このシステムは外部APIキー等の秘匿情報を持たない(図面のみ・ローカル処理)。

# 画面ログイン(評価フェーズはID+パスワードで可)。
#   TERMINAL_PASSWORD を設定すると認証が有効になる。未設定なら認証オフ(ローカル試用のみ)。
#   TERMINAL_USER を設定するとID照合も要求(空ならパスワードのみ)。
#   TERMINAL_SECRET はセッション署名鍵(固定の長いランダム文字列。未設定だと再起動でログインが切れる)。
TERMINAL_USER=tanshi
TERMINAL_PASSWORD=ここに評価用パスワードを設定
TERMINAL_SECRET=ここに十分長いランダム文字列を設定

# アップロード/生成物/保存(最終リスト・学習用CSV)/ログ の永続保存先(EBS等)。
TERMINAL_WORK=/var/lib/terminal-system/work

# 現場修正の学習コーパスの永続保存先。ハーネスと同じ領域を共有してよい
# (端子番号の学習は terminal_corrections.json / terminal_feedback/ に分離保存される)。
# コード木の外へ外部化することで、再デプロイ(git pull)で運用中の学習が巻き戻らない。
HARNESS_STATE=/var/lib/harness-system/state
