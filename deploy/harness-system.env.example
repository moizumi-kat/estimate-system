# /etc/harness-system.env の雛形。実ファイルは chmod 600 で root 所有にし、Git には含めない。
#   sudo cp deploy/harness-system.env.example /etc/harness-system.env
#   sudo chmod 600 /etc/harness-system.env
# ※このシステムは外部APIキー等の秘匿情報を持たない(ハーネス生成は図面のみ・ローカル処理)。
#   秘匿が増えた場合もこのファイルに置き、画面・ログ・チャット・Gitには出さないこと。

# 画面ログイン(評価フェーズはID+パスワードで可。社内限定運用と併用も可)。
#   HARNESS_PASSWORD を設定すると認証が有効になる。未設定なら認証オフ(ローカル試用のみ)。
#   HARNESS_USER を設定するとID照合も要求(空ならパスワードのみ)。
#   HARNESS_SECRET はセッション署名鍵(固定文字列。未設定だと再起動でログインが切れる)。
HARNESS_USER=harness
HARNESS_PASSWORD=ここに評価用パスワードを設定
HARNESS_SECRET=ここに十分長いランダム文字列を設定

# アップロード/出力/バックアップ/ログ の永続保存先(EBS等の永続領域)。
HARNESS_WORK=/var/lib/harness-system/work

# 学習結果(learned.json / design_cases.json / confirmed/)の永続保存先。
# コード木の外へ外部化することで、再デプロイ(git pull)で運用中の学習が巻き戻らない。
# 初回起動時にリポジトリ同梱の学習値から自動シードされる。
HARNESS_STATE=/var/lib/harness-system/state
