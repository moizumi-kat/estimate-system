# systemd ユニット（EC2）: 見積＋検図を gunicorn で常駐させる。
# 設置: /etc/systemd/system/estimate-system.service にコピーして
#   sudo systemctl daemon-reload && sudo systemctl enable --now estimate-system
# ---- 環境に合わせて {APP_DIR} / {APP_USER} / EnvironmentFile を書き換える ----
[Unit]
Description=Estimate + Kenzu (Flask/gunicorn)
After=network.target

[Service]
Type=simple
User={APP_USER}
Group={APP_USER}
WorkingDirectory={APP_DIR}
# 環境変数は平文でユニットに書かず、専用ファイルに置く(下記 EnvironmentFile)。
#   /etc/estimate-system.env に APP_PASSWORD=... / ANTHROPIC_API_KEY=... を記載し chmod 600。
EnvironmentFile=/etc/estimate-system.env
# matplotlib(検図R6の描画)がキャッシュを書ける場所を明示（systemd配下のHOME制限対策）
Environment=MPLBACKEND=Agg
Environment=MPLCONFIGDIR={APP_DIR}/.mplcache
# gunicorn: Vision(抽出/検図R6)が長いので timeout を大きめに。ワーカ数はvCPUに合わせて調整。
ExecStart={APP_DIR}/venv/bin/gunicorn app:app \
    --workers 3 --timeout 300 --graceful-timeout 30 \
    --bind 127.0.0.1:8000 --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
